+   SUBROUTINE accumulate_flood_infiltration (deltime)
+   ! Q-43 (paper V2): flood water the soil patches took this land step (patch
+   ! mean, mm/s) gathered per unit catchment the way runoff is [m3]
+   USE MOD_LandPatch,        only: numpatch
+   USE MOD_FloodInfiltration, only: fld_qinfl_p
+   IMPLICIT NONE
+   real(r8), intent(in) :: deltime
+   real(r8), allocatable :: q_pch(:), q_gd(:), q_uc(:)
+   real(r8), allocatable :: r_pch(:), r_gd(:), r_uc(:)
+   integer :: i
+
+      allocate (q_pch(max(numpatch,0)), q_gd(max(numinpm,0)), q_uc(max(numucat,0)))
+      q_pch = 0._r8
+      IF (allocated(fld_qinfl_p) .and. numpatch > 0) q_pch = fld_qinfl_p(1:numpatch)
+
+      IF (DEF_FLOODPLAIN_INFILT_FIX .and. allocated(fpfix_sum_p)) THEN
+         ! Q-47: a patch takes its re-infiltration from its input cells in
+         ! proportion to the flood water it was offered in each, a cell from
+         ! its unit catchments in proportion to their flood water in it, so
+         ! the routing takes the water where the soil saw it. Water that no
+         ! offered flood can place (none expected) goes by area, as without
+         ! the fix. r_pch [mm s-1 m-1] times the cell water gives the cell
+         ! share [mm s-1 m2], which is then split by fpfix_sum_gd.
+         allocate (r_pch(max(numpatch,0)), r_gd(max(numinpm,0)), r_uc(max(numucat,0)))
+         DO i = 1, numpatch
+            r_pch(i) = 0._r8
+            IF (fpfix_sum_p(i) > 0._r8) THEN
+               r_pch(i) = q_pch(i) * remap_patch2inpm%sum_area(i) / fpfix_sum_p(i)
+               q_pch(i) = 0._r8
+            ENDIF
+         ENDDO
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, r_pch, r_gd, &
+            fillvalue = 0., filter = filter_rnof)
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, q_pch, q_gd, &
+            fillvalue = 0., filter = filter_rnof)
+         DO i = 1, numinpm
+            r_gd(i) = r_gd(i) * fpfix_wat_gd(i)
+            IF (fpfix_sum_gd(i) > 0._r8) THEN
+               r_gd(i) = r_gd(i) / fpfix_sum_gd(i)
+            ELSE
+               q_gd(i) = q_gd(i) + r_gd(i)
+               r_gd(i) = 0._r8
+            ENDIF
+            IF (push_ucat2inpm%sum_area(i) > 0) q_gd(i) = q_gd(i) / push_ucat2inpm%sum_area(i)
+         ENDDO
+         CALL worker_push_data (push_inpm2ucat, r_gd, r_uc, fillvalue = 0., mode = 'sum')
+         CALL worker_push_data (push_inpm2ucat, q_gd, q_uc, fillvalue = 0., mode = 'sum')
+         IF (numucat > 0) q_uc = q_uc + fpfix_wat_uc * r_uc
+         deallocate (r_pch, r_gd, r_uc)
+      ELSE
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, q_pch, q_gd, &
+            fillvalue = 0., filter = filter_rnof)
+         IF (numinpm > 0) THEN
+            WHERE (push_ucat2inpm%sum_area > 0)
+               q_gd = q_gd / push_ucat2inpm%sum_area
+            END WHERE
+         ENDIF
+         CALL worker_push_data (push_inpm2ucat, q_gd, q_uc, fillvalue = 0., mode = 'sum')
+      ENDIF
+      IF (numucat > 0) acc_inf_uc = acc_inf_uc + q_uc * 1.e-3_r8 * deltime
+      deallocate (q_pch, q_gd, q_uc)
+
+   END SUBROUTINE accumulate_flood_infiltration
+
+   SUBROUTINE publish_flood_to_soil (total_floodarea_in, total_flooddepth_in)
+   ! Q-43 (paper V2): flooded fraction and flood depth [mm] on the patches, the
+   ! same ucat -> grid -> patch mapping the tracers get, for WATER_VSF
+   USE MOD_Grid_RiverLakeNetwork, only: numucat, numinpm, topo_area, &
+                                        push_ucat2inpm, remap_patch2inpm
+   USE MOD_WorkerPushData, only: worker_push_data, worker_remap_data_grid2pset
+   USE MOD_LandPatch, only: numpatch
+   USE MOD_FloodInfiltration, only: flood_infil_alloc, fld_frc_p, fld_dph_p, fld_cap_p
+   IMPLICIT NONE
+   real(r8), intent(in) :: total_floodarea_in(:)
+   real(r8), intent(in) :: total_flooddepth_in(:)
+   real(r8), allocatable :: frc_uc(:), wat_uc(:), frc_gd(:), wat_gd(:), frc_p(:), wat_p(:)
+   integer :: i
+
+      IF (.not. p_is_worker) RETURN
+      CALL flood_infil_alloc (numpatch)
+      allocate (frc_uc(max(numucat,0)), wat_uc(max(numucat,0)))
+      DO i = 1, numucat
+         frc_uc(i) = 0._r8; wat_uc(i) = 0._r8
+         IF (topo_area(i) > 0._r8 .and. i <= size(total_floodarea_in)) THEN
+            frc_uc(i) = min(1._r8, max(0._r8, total_floodarea_in(i) / topo_area(i)))
+            IF (i <= size(total_flooddepth_in)) wat_uc(i) = frc_uc(i) * max(0._r8, total_flooddepth_in(i))
+         ENDIF
+      ENDDO
+      allocate (frc_gd(max(numinpm,0)), wat_gd(max(numinpm,0)), frc_p(max(numpatch,0)), wat_p(max(numpatch,0)))
+      CALL worker_push_data (push_ucat2inpm, frc_uc, frc_gd, fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      CALL worker_remap_data_grid2pset (remap_patch2inpm, frc_gd, frc_p, &
+         fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      CALL worker_push_data (push_ucat2inpm, wat_uc, wat_gd, fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      CALL worker_remap_data_grid2pset (remap_patch2inpm, wat_gd, wat_p, &
+         fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      DO i = 1, numpatch
+         IF (frc_p(i) == RIVERLAKE_FLOOD_MISSING_VALUE) frc_p(i) = 0._r8
+         IF (wat_p(i) == RIVERLAKE_FLOOD_MISSING_VALUE) wat_p(i) = 0._r8
+         fld_frc_p(i) = frc_p(i)
+         fld_dph_p(i) = 0._r8
+         IF (frc_p(i) > 0._r8) fld_dph_p(i) = max(0._r8, wat_p(i)) / frc_p(i) * 1.e3_r8   ! [mm]
+         ! I-28: the soil floods only up to the bound the land sets; the depth
+         ! over the flooded part stays, the rest of the water stays routed
+         IF (allocated(fld_cap_p)) THEN
+            IF (i <= size(fld_cap_p)) fld_frc_p(i) = min(fld_frc_p(i), fld_cap_p(i))
+         ENDIF
+      ENDDO
+      deallocate (frc_uc, wat_uc, frc_gd, wat_gd, frc_p, wat_p)
+
+   END SUBROUTINE publish_flood_to_soil
+
+   SUBROUTINE publish_flood_to_soil_fix (total_floodarea_in, total_flooddepth_in)
+   ! Q-47 (paper V2), DEF_FLOODPLAIN_INFILT_FIX: flooded fraction and flood
+   ! depth [mm] of the soil patches, and the flood water offered per input
+   ! cell, per unit catchment and per patch, by which
+   ! accumulate_flood_infiltration shares the re-infiltration of the land
+   ! steps until the next routing step among the unit catchments.
+   ! The flood of the unit catchments flagged as flooded all last year
+   ! (fld_perm_uc) is offered to no soil. In each input cell the flood lies
+   ! on its lake and wetland patches first, and that of the flagged unit
+   ! catchments stays off the soil: the soil gets the cell flooded fraction
+   ! beyond the larger of the lake and wetland share and the flagged flooded
+   ! fraction, over its own share, at most 1, with the depth of the flood of
+   ! the unflagged unit catchments.
+   USE MOD_Grid_RiverLakeNetwork, only: numucat, numinpm, topo_area, &
+                                        push_ucat2inpm, remap_patch2inpm, allreduce_inpm
+   USE MOD_WorkerPushData, only: worker_push_data, worker_remap_data_grid2pset, &
+                                 worker_remap_data_pset2grid
+   USE MOD_LandPatch, only: numpatch
+   USE MOD_Vars_TimeInvariants, only: patchtype
+   USE MOD_FloodInfiltration, only: flood_infil_alloc, fld_frc_p, fld_dph_p, fld_cap_p
+   IMPLICIT NONE
+   real(r8), intent(in) :: total_floodarea_in(:)
+   real(r8), intent(in) :: total_flooddepth_in(:)
+   real(r8), allocatable :: frc_uc(:), wat_uc(:), frc_gd(:), wat_gd(:), frc_p(:), wat_p(:)
+   real(r8), allocatable :: prm_uc(:), prm_gd(:)
+   real(r8), allocatable :: one_p(:), land_gd(:), land_all(:), part_gd(:), part_all(:)
+   real(r8) :: fn, dn, fs
+   integer :: i
+
+      IF (.not. p_is_worker) RETURN
+      CALL flood_infil_alloc (numpatch)
+      IF (.not. allocated(fpfix_sum_p)) THEN
+         allocate (fpfix_wat_gd(max(numinpm,0)), fpfix_sum_gd(max(numinpm,0)))
+         allocate (fpfix_wat_uc(max(numucat,0)), fpfix_sum_p (max(numpatch,0)))
+      ENDIF
+
+      ! lake and wetland share, and soil share, of the land of each input cell
+      IF (.not. allocated(fpfix_lwf_gd)) THEN
+         allocate (fpfix_lwf_gd(max(numinpm,0)), fpfix_slf_gd(max(numinpm,0)))
+         allocate (one_p(max(numpatch,0)))
+         allocate (land_gd(max(numinpm,0)), land_all(max(numinpm,0)))
+         allocate (part_gd(max(numinpm,0)), part_all(max(numinpm,0)))
+         IF (numpatch > 0) one_p = 1._r8
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, one_p, land_gd, &
+            fillvalue = 0._r8, filter = filter_rnof)
+         CALL worker_push_data (allreduce_inpm, land_gd, land_all, fillvalue = 0._r8)
+         DO i = 1, numpatch
+            one_p(i) = 0._r8
+            IF (patchtype(i) == 2 .or. patchtype(i) == 4) one_p(i) = 1._r8
+         ENDDO
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, one_p, part_gd, &
+            fillvalue = 0._r8, filter = filter_rnof)
+         CALL worker_push_data (allreduce_inpm, part_gd, part_all, fillvalue = 0._r8)
+         DO i = 1, numinpm
+            fpfix_lwf_gd(i) = 0._r8
+            IF (land_all(i) > 0._r8) fpfix_lwf_gd(i) = min(1._r8, max(0._r8, part_all(i) / land_all(i)))
+         ENDDO
+         DO i = 1, numpatch
+            one_p(i) = 0._r8
+            IF (patchtype(i) == 0) one_p(i) = 1._r8
+         ENDDO
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, one_p, part_gd, &
+            fillvalue = 0._r8, filter = filter_rnof)
+         CALL worker_push_data (allreduce_inpm, part_gd, part_all, fillvalue = 0._r8)
+         DO i = 1, numinpm
+            fpfix_slf_gd(i) = 0._r8
+            IF (land_all(i) > 0._r8) fpfix_slf_gd(i) = min(1._r8, max(0._r8, part_all(i) / land_all(i)))
+         ENDDO
+         deallocate (one_p, land_gd, land_all, part_gd, part_all)
+      ENDIF
+
+      ! flooded fraction, its flagged part, and the flood water [m] of the
+      ! unflagged unit catchments
+      allocate (frc_uc(max(numucat,0)), wat_uc(max(numucat,0)), prm_uc(max(numucat,0)))
+      DO i = 1, numucat
+         frc_uc(i) = 0._r8; wat_uc(i) = 0._r8
+         IF (topo_area(i) > 0._r8 .and. i <= size(total_floodarea_in)) THEN
+            frc_uc(i) = min(1._r8, max(0._r8, total_floodarea_in(i) / topo_area(i)))
+            IF (i <= size(total_flooddepth_in)) wat_uc(i) = frc_uc(i) * max(0._r8, total_flooddepth_in(i))
+         ENDIF
+         prm_uc(i) = frc_uc(i) * fld_perm_uc(i)
+         wat_uc(i) = wat_uc(i) * (1._r8 - fld_perm_uc(i))
+      ENDDO
+      allocate (frc_gd(max(numinpm,0)), wat_gd(max(numinpm,0)), prm_gd(max(numinpm,0)))
+      allocate (frc_p(max(numpatch,0)), wat_p(max(numpatch,0)))
+      CALL worker_push_data (push_ucat2inpm, frc_uc, frc_gd, fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      CALL worker_push_data (push_ucat2inpm, prm_uc, prm_gd, fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      CALL worker_push_data (push_ucat2inpm, wat_uc, wat_gd, fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      ! the unflagged unit catchment flood water per cell, summed by the mapping areas
+      CALL worker_push_data (push_ucat2inpm, wat_uc, fpfix_sum_gd, fillvalue = 0._r8, mode = 'sum')
+
+      ! the flood the soil of each cell gets: fraction of the soil share and
+      ! water depth over the cell [m]
+      DO i = 1, numinpm
+         IF (frc_gd(i) == RIVERLAKE_FLOOD_MISSING_VALUE) CYCLE
+         IF (prm_gd(i) == RIVERLAKE_FLOOD_MISSING_VALUE) prm_gd(i) = 0._r8
+         IF (wat_gd(i) == RIVERLAKE_FLOOD_MISSING_VALUE) wat_gd(i) = 0._r8
+         fn = max(frc_gd(i) - prm_gd(i), 0._r8)
+         dn = 0._r8
+         IF (fn > 0._r8) dn = max(0._r8, wat_gd(i)) / fn
+         fs = 0._r8
+         IF (fpfix_slf_gd(i) > 0._r8) &
+            fs = min(1._r8, max(0._r8, frc_gd(i) - max(prm_gd(i), fpfix_lwf_gd(i))) / fpfix_slf_gd(i))
+         frc_gd(i) = fs
+         wat_gd(i) = fs * dn
+      ENDDO
+
+      CALL worker_remap_data_grid2pset (remap_patch2inpm, frc_gd, frc_p, &
+         fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      CALL worker_remap_data_grid2pset (remap_patch2inpm, wat_gd, wat_p, &
+         fillvalue = RIVERLAKE_FLOOD_MISSING_VALUE, mode = 'average')
+      DO i = 1, numpatch
+         IF (frc_p(i) == RIVERLAKE_FLOOD_MISSING_VALUE) frc_p(i) = 0._r8
+         IF (wat_p(i) == RIVERLAKE_FLOOD_MISSING_VALUE) wat_p(i) = 0._r8
+         fld_frc_p(i) = frc_p(i)
+         fld_dph_p(i) = 0._r8
+         IF (frc_p(i) > 0._r8) fld_dph_p(i) = max(0._r8, wat_p(i)) / frc_p(i) * 1.e3_r8   ! [mm]
+         ! I-28: bounded as in publish_flood_to_soil; the shares of the water
+         ! offered below do not depend on it, so the routing still takes back
+         ! exactly what the soil re-infiltrates
+         IF (allocated(fld_cap_p)) THEN
+            IF (i <= size(fld_cap_p)) fld_frc_p(i) = min(fld_frc_p(i), fld_cap_p(i))
+         ENDIF
+      ENDDO
+
+      ! the water offered per cell and unit catchment, and per patch its cell
+      ! water summed over the patch area in each cell
+      DO i = 1, numinpm
+         fpfix_wat_gd(i) = 0._r8
+         IF (wat_gd(i) /= RIVERLAKE_FLOOD_MISSING_VALUE) fpfix_wat_gd(i) = max(0._r8, wat_gd(i))
+      ENDDO
+      IF (numucat > 0) fpfix_wat_uc = wat_uc
+      CALL worker_remap_data_grid2pset (remap_patch2inpm, fpfix_wat_gd, fpfix_sum_p, &
+         fillvalue = 0._r8, mode = 'sum')
+      deallocate (frc_uc, wat_uc, prm_uc, frc_gd, wat_gd, prm_gd, frc_p, wat_p)
+
+   END SUBROUTINE publish_flood_to_soil_fix
+
+   SUBROUTINE accumulate_floodplain_evap (deltime)
+   ! C-44 (paper V2): Penman (1948) open-water evaporation in the form of
+   ! Shuttleworth (1993), E = [Delta Rn + gamma 6.43 (1 + 0.536 u2) D] /
+   ! [lambda (Delta + gamma)] in mm d-1 (Rn in MJ m-2 d-1, D in kPa), for a
+   ! water surface at air temperature (albedo 0.06, emissivity 0.97), u2 from
+   ! the forcing wind by the FAO-56 log profile, none below freezing. Night-time
+   ! negative values are kept, so a routing step takes the net demand. The
+   ! patch values go to unit catchments the way precipitation does for tracers.
+
+   USE MOD_LandPatch,      only: numpatch
+   USE MOD_Vars_1DForcing, only: forc_t, forc_q, forc_psrf, forc_us, forc_vs, forc_hgt_u, &
+      forc_sols, forc_soll, forc_solsd, forc_solld, forc_frl
+   USE MOD_Const_Physical, only: tfrz, stefnc
+   IMPLICIT NONE
+
+   real(r8), intent(in) :: deltime
+
+   real(r8), allocatable :: e_pch(:), e_gd(:), e_uc(:)
+   real(r8) :: tc, pkpa, es, ea, delta, gamma, rn, u2, z
+   integer  :: ip
+
+      IF (.not. allocated(acc_evp_uc)) THEN
+         allocate (acc_evp_uc (max(numucat,0)))
+         acc_evp_uc = 0._r8
+      ENDIF
+
+      allocate (e_pch (max(numpatch,0)))
+      allocate (e_gd  (max(numinpm, 0)))
+      allocate (e_uc  (max(numucat, 0)))
+
+      DO ip = 1, numpatch
+         e_pch(ip) = 0._r8
+         IF (.not. filter_rnof(ip)) CYCLE
+         tc = forc_t(ip) - tfrz
+         IF (tc <= 0._r8) CYCLE
+         pkpa  = forc_psrf(ip) * 1.e-3_r8
+         es    = 0.6108_r8 * exp(17.27_r8 * tc / (tc + 237.3_r8))
+         ea    = forc_q(ip) * pkpa / (0.622_r8 + 0.378_r8 * forc_q(ip))
+         delta = 4098._r8 * es / (tc + 237.3_r8)**2
+         gamma = 0.000665_r8 * pkpa
+         rn    = 0.94_r8 * (forc_sols(ip) + forc_soll(ip) + forc_solsd(ip) + forc_solld(ip)) &
+               + 0.97_r8 * (forc_frl(ip) - stefnc * forc_t(ip)**4)
+         z     = max(forc_hgt_u(ip), 2.1_r8)
+         u2    = sqrt(forc_us(ip)**2 + forc_vs(ip)**2) * 4.87_r8 / log(67.8_r8 * z - 5.42_r8)
+         e_pch(ip) = (delta * rn * 0.0864_r8 + gamma * 6.43_r8 * (1._r8 + 0.536_r8 * u2) &
+                   * max(es - ea, 0._r8)) / (2.45_r8 * (delta + gamma))          ! [mm d-1]
+      ENDDO
+
+      CALL worker_remap_data_pset2grid (remap_patch2inpm, e_pch, e_gd, &
+         fillvalue = 0., filter = filter_rnof)
+      IF (numinpm > 0) THEN
+         WHERE (push_ucat2inpm%sum_area > 0)
+            e_gd = e_gd / push_ucat2inpm%sum_area
+         END WHERE
+      ENDIF
+      CALL worker_push_data (push_inpm2ucat, e_gd, e_uc, fillvalue = 0., mode = 'sum')
+
+      IF (numucat > 0) THEN
+         WHERE (topo_area > 0._r8)
+            e_uc = e_uc / topo_area
+         ELSEWHERE
+            e_uc = 0._r8
+         END WHERE
+         acc_evp_uc = acc_evp_uc + e_uc * 1.e-3_r8 / 86400._r8 * deltime        ! [m]
+      ENDIF
+
+      deallocate (e_pch, e_gd, e_uc)
+
+   END SUBROUTINE accumulate_floodplain_evap
+
+   SUBROUTINE accumulate_lake_deficit (deltime)
+   ! I-29 (paper V2): the lake patches (patchtype 4) give no runoff when their
+   ! evaporation exceeds their precipitation, and the land side books the
+   ! difference (lake_deficit, mm/s) as water put back into the patch. Gather
+   ! it per unit catchment the way runoff is [m3], for the routing step to
+   ! take out of the storage. On the first call also map the lake patch area
+   ! to the unit catchments [m2], by which C-44 leaves the lakes out.
+   USE MOD_LandPatch,           only: numpatch
+   USE MOD_Vars_TimeInvariants, only: patchtype
+   USE MOD_Vars_1DFluxes,       only: lake_deficit
+   USE MOD_Vars_Global,         only: spval
