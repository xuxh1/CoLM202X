       CALL mpi_bcast (DEF_RICE_GRNFILL                       ,1   ,mpi_real8     ,p_address_master ,p_comm_glb ,p_err)
       CALL mpi_bcast (DEF_PADDY_DRAIN_DAYS                   ,1   ,mpi_real8     ,p_address_master ,p_comm_glb ,p_err)
