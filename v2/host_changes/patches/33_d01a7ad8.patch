From d01a7ad82043cfee8459032ec7740388f11539a5 Mon Sep 17 00:00:00 2001
From: xuxh1 <18172956238@163.com>
Date: Mon, 28 Sep 2026 14:04:09 +0800
Subject: [PATCH] feat(rice): drain paddies a set number of days before the
 projected harvest (C-47)

DEF_PADDY_DRAIN_DAYS (default -1 keeps C-32e, drained from grain fill):
bunds and irrigation of a paddy stop once the days left to the earlier of
maturity, projected at the season's mean heat-unit rate, and the maximum
season length fall to the set value. With the rice grain fill moved to
hui 0.40 (Q-33) the grain-fill anchor drained the fields in early July,
a month before the towers' peak; farmers drain two to three weeks before
harvest.

---
 main/BGC/MOD_BGC_Vars_PFTimeVariables.F90 |  3 +++
 main/BGC/MOD_BGC_Veg_CNPhenology.F90      | 17 +++++++++++++++--
 main/MOD_Irrigation.F90                   | 11 +++++++----
 main/MOD_SoilSnowHydrology.F90            | 15 +++++++++++----
 share/MOD_Namelist.F90                    |  6 ++++++
 5 files changed, 42 insertions(+), 10 deletions(-)

diff --git a/main/BGC/MOD_BGC_Vars_PFTimeVariables.F90 b/main/BGC/MOD_BGC_Vars_PFTimeVariables.F90
index eb1841a0..70ad93d0 100644
--- a/main/BGC/MOD_BGC_Vars_PFTimeVariables.F90
+++ b/main/BGC/MOD_BGC_Vars_PFTimeVariables.F90
@@ -165,6 +165,7 @@ MODULE MOD_BGC_Vars_PFTimeVariables
    real(r8),allocatable :: latbaset_p                (:)     ! latitude vary base temperature for gddplant (degree C)
    real(r8),allocatable :: plantdate_p               (:)     ! planting date (input)
    real(r8),allocatable :: rice_double_p             (:)     ! C-45: share of double-cropped irrigated rice (input, not in restart)
+   logical ,allocatable :: paddy_predrain_p          (:)     ! C-47: paddy in its pre-harvest drain window (set by CropPhenology, not in restart)
 #endif
 ! --------------------- END CROP variables -------------------------
 
@@ -561,6 +562,7 @@ CONTAINS
             allocate (latbaset_p               (numpft)); latbaset_p               (:) = spval
             allocate (plantdate_p              (numpft)); plantdate_p              (:) = spval
             allocate (rice_double_p            (numpft)); rice_double_p            (:) = 0._r8
+            allocate (paddy_predrain_p         (numpft)); paddy_predrain_p         (:) = .false.
 #endif
 
 ! SASU variables
@@ -2097,6 +2099,7 @@ CONTAINS
             deallocate (latbaset_p               )
             deallocate (plantdate_p              )
             deallocate (rice_double_p            )
+            deallocate (paddy_predrain_p         )
 #endif
 
 ! SASU variables
diff --git a/main/BGC/MOD_BGC_Veg_CNPhenology.F90 b/main/BGC/MOD_BGC_Veg_CNPhenology.F90
index d1b73d55..67054c7d 100644
--- a/main/BGC/MOD_BGC_Veg_CNPhenology.F90
+++ b/main/BGC/MOD_BGC_Veg_CNPhenology.F90
@@ -81,7 +81,7 @@ MODULE MOD_BGC_Veg_CNPhenology
        hui_p             , peaklai_p           , &
        tref_min_p        , tref_max_p          , tref_min_inst_p     , tref_max_inst_p  , &
        manunitro_p       , fertnitro_p         , plantdate_p         , fert_p           , &! input from files
-       rice_double_p     , &
+       rice_double_p     , paddy_predrain_p    , &
 #endif
 
        leaf_prof_p        , froot_prof_p        , &
@@ -133,7 +133,7 @@ MODULE MOD_BGC_Veg_CNPhenology
 
    USE MOD_TimeManager
    USE MOD_Precision
-   USE MOD_Namelist, only: DEF_USE_FERT, DEF_RICE_GRNFILL
+   USE MOD_Namelist, only: DEF_USE_FERT, DEF_RICE_GRNFILL, DEF_PADDY_DRAIN_DAYS
    USE MOD_BGC_Daylength, only: daylength
    USE MOD_SPMD_Task
 
@@ -1027,6 +1027,7 @@ CONTAINS
    integer ivt
    logical :: sow_now, end_second
    real(r8) :: gf      ! grain-fill threshold of this crop (Q-33: rice may take DEF_RICE_GRNFILL)
+   real(r8) :: days_left ! C-47: projected days to harvest
 
     !------------------------------------------------------------------------
 
@@ -1122,6 +1123,17 @@ CONTAINS
                   idpp = int(dayspyr) + jday - idop_p(m)
                ENDIF
 
+              ! C-47: the pre-harvest drain window of a paddy, from the days
+              ! left to the earlier of maturity (at the season's mean heat-unit
+              ! rate so far) and the maximum season length
+               paddy_predrain_p(m) = .false.
+               IF (DEF_PADDY_DRAIN_DAYS >= 0._r8 .and. (ivt == nrice .or. ivt == nirrig_rice)) THEN
+                  days_left = real(mxmat(ivt) - idpp, r8)
+                  IF (hui_p(m) > 0.05_r8 .and. idpp > 0) &
+                     days_left = min(days_left, real(idpp, r8) * (1._r8 - hui_p(m)) / hui_p(m))
+                  paddy_predrain_p(m) = days_left <= DEF_PADDY_DRAIN_DAYS
+               ENDIF
+
               ! onset_counter initialized to zero when .not. croplive
               ! offset_counter relevant only at time step of harvest
 
@@ -1226,6 +1238,7 @@ CONTAINS
                ENDIF
 
             ELSE   ! crop not live
+               paddy_predrain_p(m) = .false.
               ! next 2 lines conserve mass IF leaf*_xfer > 0 due to interpinic.
               ! We subtract from any existing value in crop_seedc_to_leaf /
               ! crop_seedn_to_leaf in the unlikely event that we enter this block of
