          CALL vector_read_and_scatter (file_restart, volwater_ucat, numucat, 'volwater_ucat', ucat_data_address)
       ENDIF
 
+      ! Q-47: re-infiltration the storage still owes; a restart written
+      ! without DEF_FLOODPLAIN_INFILT_FIX owes none
+      IF (DEF_FLOODPLAIN_INFILTRATION .and. DEF_FLOODPLAIN_INFILT_FIX .and. totalnumucat > 0) THEN
