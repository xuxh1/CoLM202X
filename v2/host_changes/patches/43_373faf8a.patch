-         WHERE (push_ucat2inpm%sum_area > 0)
-            q_gd = q_gd / push_ucat2inpm%sum_area
-         END WHERE
+
+      IF (DEF_FLOODPLAIN_INFILT_FIX .and. allocated(fpfix_sum_p)) THEN
+         ! Q-47: a patch takes its re-infiltration from its input cells in
+         ! proportion to the flood water it was offered in each, a cell from
+         ! its unit catchments in proportion to their flood water in it, so
+         ! the routing takes the water where the soil saw it. Water that no
+         ! offered flood can place (none expected) goes by area, as without
+         ! the fix. r_pch [mm s-1 m-1] times the cell water gives the cell
+         ! share [mm s-1 m2], which is then split by fpfix_sum_gd.
+         allocate (r_pch(max(numpatch,0)), r_gd(max(numinpm,0)), r_uc(max(numucat,0)))
