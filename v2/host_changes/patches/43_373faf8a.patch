+         IF (numucat > 0) q_uc = q_uc + fpfix_wat_uc * r_uc
+         deallocate (r_pch, r_gd, r_uc)
+      ELSE
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, q_pch, q_gd, &
+            fillvalue = 0., filter = filter_rnof)
+         IF (numinpm > 0) THEN
+            WHERE (push_ucat2inpm%sum_area > 0)
+               q_gd = q_gd / push_ucat2inpm%sum_area
+            END WHERE
+         ENDIF
+         CALL worker_push_data (push_inpm2ucat, q_gd, q_uc, fillvalue = 0., mode = 'sum')
       ENDIF
-      CALL worker_push_data (push_inpm2ucat, q_gd, q_uc, fillvalue = 0., mode = 'sum')
       IF (numucat > 0) acc_inf_uc = acc_inf_uc + q_uc * 1.e-3_r8 * deltime
