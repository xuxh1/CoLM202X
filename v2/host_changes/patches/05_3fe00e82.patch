From 3fe00e828cd2ea451466f15e24973eac1dc1eb9f Mon Sep 17 00:00:00 2001
From: xuxh1 <18172956238@163.com>
Date: Fri, 25 Sep 2026 08:31:50 +0800
Subject: [PATCH] refactor(methane): carry the C-13 site overrides as
 DEF_METHANE keys

The site namelist writer only knows a fixed set of SITE_ keys, while its
per-site parameter table appends DEF_METHANE lines; move the two overrides
there (wetland_forest_share_site, wetland_lai_cap_site) and drop the
SITE_ keys added in a3ec57a0.

---
 share/MOD_Namelist.F90 | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/share/MOD_Namelist.F90 b/share/MOD_Namelist.F90
index eeece2ec..39c7d400 100644
--- a/share/MOD_Namelist.F90
+++ b/share/MOD_Namelist.F90
@@ -64,10 +64,6 @@ MODULE MOD_Namelist
    real(r8) :: SITE_lat_location = -1.e36_r8
 
    integer  :: SITE_landtype             = -1
-   ! C-13 (paper V2) single-point overrides of the gridded GLWD wetland make-up:
-   ! the tower's woody share and the LAI peak of its non-woody share (< 0: use the file)
-   real(r8) :: SITE_wetland_forest_share = -1._r8
-   real(r8) :: SITE_wetland_lai_cap      = -1._r8
 
    logical  :: USE_SITE_landtype         = .false.
    logical  :: USE_SITE_pctpfts          = .true.
@@ -1092,8 +1088,6 @@ CONTAINS
       SITE_lon_location,                      &
       SITE_lat_location,                      &
       SITE_landtype,                          &
-      SITE_wetland_forest_share,              &
-      SITE_wetland_lai_cap,                   &
       USE_SITE_landtype,                      &
       USE_SITE_pctpfts,                       &
       USE_SITE_pctcrop,                       &
-- 
2.53.0

