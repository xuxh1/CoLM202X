From 5a0caa1f75f3c1bd4fe117f8f600df8c06e1280f Mon Sep 17 00:00:00 2001
From: xuxh1 <18172956238@163.com>
Date: Sun, 27 Sep 2026 23:21:48 +0800
Subject: [PATCH] feat(rice): root exudates of live rice feed the metabolic
 litter (C-37)

---
 main/BGC/MOD_BGC_CNCStateUpdate1.F90         |  4 ++-
 main/BGC/MOD_BGC_Vars_1DPFTFluxes.F90        |  3 +++
 main/BGC/MOD_BGC_Veg_NutrientCompetition.F90 | 27 +++++++++++++++++++-
 share/MOD_Namelist.F90                       |  6 +++++
 4 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/main/BGC/MOD_BGC_CNCStateUpdate1.F90 b/main/BGC/MOD_BGC_CNCStateUpdate1.F90
index fdb6d660..8a9428de 100644
--- a/main/BGC/MOD_BGC_CNCStateUpdate1.F90
+++ b/main/BGC/MOD_BGC_CNCStateUpdate1.F90
@@ -84,7 +84,7 @@ MODULE MOD_BGC_CNCStateUpdate1
    USE MOD_BGC_Vars_1DPFTFluxes, only: &
 ! vegetation carbon flux variables (in)
 ! Vegetation physiology
-            psn_to_cpool_p, &
+            psn_to_cpool_p, rice_exudc_p, &
 
 ! xfer to display
             leafc_xfer_to_leafc_p          , frootc_xfer_to_frootc_p        , &
@@ -271,6 +271,8 @@ CONTAINS
 #ifdef FUN
          cpool_p   (m) = cpool_p   (m) - soilc_change_p     (m) * deltim
 #endif
+         ! C-37: rice root exudates, booked into metabolic litter this step
+         cpool_p   (m) = cpool_p   (m) - rice_exudc_p       (m) * deltim
          xsmrpool_p(m) = xsmrpool_p(m) + cpool_to_xsmrpool_p(m) * deltim
          xsmrpool_p(m) = xsmrpool_p(m) - leaf_xsmr_p        (m) * deltim
          xsmrpool_p(m) = xsmrpool_p(m) - froot_xsmr_p       (m) * deltim
diff --git a/main/BGC/MOD_BGC_Vars_1DPFTFluxes.F90 b/main/BGC/MOD_BGC_Vars_1DPFTFluxes.F90
index 2cfbe3ed..3701dd39 100644
--- a/main/BGC/MOD_BGC_Vars_1DPFTFluxes.F90
+++ b/main/BGC/MOD_BGC_Vars_1DPFTFluxes.F90
@@ -298,6 +298,7 @@ MODULE MOD_BGC_Vars_1DPFTFluxes
    real(r8), allocatable :: psn_to_cpool_p               (:) ! pft level: photosynthesis rate (gC m-2 s-1)
    real(r8), allocatable :: gpp_p                        (:) ! pft level: gross primary production (gC m-2 s-1)
    real(r8), allocatable :: availc_p                     (:) ! pft level: available C (gC m-2 s-1)
+   real(r8), allocatable :: rice_exudc_p                 (:) ! pft level: rice root exudate C to metabolic litter (gC m-2 s-1), C-37
    real(r8), allocatable :: avail_retransn_p             (:) ! pft level: available retranslocated N (gN m-2 s-1)
    real(r8), allocatable :: xsmrpool_recover_p           (:) ! pft level: available C to maintenance respiration storage C to recover previous excess mainte
    real(r8), allocatable :: excess_cflux_p               (:) ! pft level: excess C due to N limitation (gC m-2 s-1)
@@ -629,6 +630,7 @@ CONTAINS
             allocate (psn_to_cpool_p               (numpft)) ; psn_to_cpool_p               (:) = spval
             allocate (gpp_p                        (numpft)) ; gpp_p                        (:) = spval
             allocate (availc_p                     (numpft)) ; availc_p                     (:) = spval
+            allocate (rice_exudc_p                 (numpft)) ; rice_exudc_p                 (:) = 0._r8
             allocate (avail_retransn_p             (numpft)) ; avail_retransn_p             (:) = spval
             allocate (xsmrpool_recover_p           (numpft)) ; xsmrpool_recover_p           (:) = spval
             allocate (excess_cflux_p               (numpft)) ; excess_cflux_p               (:) = spval
@@ -951,6 +953,7 @@ CONTAINS
             deallocate (psn_to_cpool_p               )
             deallocate (gpp_p                        )
             deallocate (availc_p                     )
+            deallocate (rice_exudc_p                 )
             deallocate (avail_retransn_p             )
             deallocate (xsmrpool_recover_p           )
             deallocate (excess_cflux_p               )
diff --git a/main/BGC/MOD_BGC_Veg_NutrientCompetition.F90 b/main/BGC/MOD_BGC_Veg_NutrientCompetition.F90
index 3dba43ad..58e5dfdf 100644
--- a/main/BGC/MOD_BGC_Veg_NutrientCompetition.F90
+++ b/main/BGC/MOD_BGC_Veg_NutrientCompetition.F90
@@ -56,7 +56,12 @@ MODULE MOD_BGC_Veg_NutrientCompetition
        npool_to_deadcrootn_p, npool_to_deadcrootn_storage_p, npool_to_grainn_p, npool_to_grainn_storage_p, &
        leafn_to_retransn_p, livestemn_to_retransn_p, frootn_to_retransn_p, &
        plant_calloc_p, plant_nalloc_p, leaf_curmr_p, froot_curmr_p, livestem_curmr_p, livecroot_curmr_p, grain_curmr_p, &
-       psn_to_cpool_p, gpp_p, availc_p, avail_retransn_p, xsmrpool_recover_p, sminn_to_npool_p, excess_cflux_p
+       psn_to_cpool_p, gpp_p, availc_p, avail_retransn_p, xsmrpool_recover_p, sminn_to_npool_p, excess_cflux_p, &
+       rice_exudc_p
+   USE MOD_BGC_Vars_1DFluxes, only: phenology_to_met_c
+   USE MOD_BGC_Vars_PFTimeVariables, only: froot_prof_p
+   USE MOD_Namelist, only: DEF_RICE_ROOT_EXUDATE
+   USE MOD_Vars_Global, only: nl_soil, nrice, nirrig_rice
 
    IMPLICIT NONE
 
@@ -348,6 +353,26 @@ CONTAINS
             cpool_to_xsmrpool_p(m) = xsmrpool_recover_p(m)
          ENDIF
 
+      ! C-37: live rice exudes a share of its net assimilate (available C less
+      ! the growth respiration its allocation would cost) from the roots; it
+      ! leaves cpool (CNCStateUpdate1) and joins the metabolic litter along the
+      ! fine-root profile, the labile C that feeds paddy CH4 mid-season
+      ! (Watanabe et al. 1999; Minoda and Kimura 1994; Wania et al. 2010 for
+      ! the wetland counterpart C-23)
+         rice_exudc_p(m) = 0._r8
+#ifdef CROP
+         IF (DEF_RICE_ROOT_EXUDATE > 0._r8 .and. (ivt == nrice .or. ivt == nirrig_rice)) THEN
+            IF (croplive_p(m) .and. availc_p(m) > 0._r8) THEN
+               rice_exudc_p(m) = DEF_RICE_ROOT_EXUDATE * availc_p(m) / (1._r8 + grperc(ivt))
+               availc_p(m) = availc_p(m) - rice_exudc_p(m)
+               DO j = 1, nl_soil
+                  phenology_to_met_c(j,i) = phenology_to_met_c(j,i) &
+                     + rice_exudc_p(m) * froot_prof_p(j,m) * pftfrac(m)
+               ENDDO
+            ENDIF
+         ENDIF
+#endif
+
          f1 = froot_leaf(ivt)
          f2 = croot_stem(ivt)
 
diff --git a/share/MOD_Namelist.F90 b/share/MOD_Namelist.F90
index b2aa3f07..62bd1b24 100644
--- a/share/MOD_Namelist.F90
+++ b/share/MOD_Namelist.F90
@@ -422,6 +422,10 @@ MODULE MOD_Namelist
    ! any paddy only from planting to harvest (cphase 1-4). Needs
    ! DEF_USE_IRRIGATION (the paddy method is set in MOD_Irrigation).
    logical :: DEF_PADDY_RICE_BUND       = .false.
+   ! C-37 (paper V2): share of the net assimilate (available C less growth
+   ! respiration) of live rice (PFT 61, 62) its roots exude; it enters the
+   ! metabolic litter along the fine-root profile. 0 is off.
+   real(r8) :: DEF_RICE_ROOT_EXUDATE    = 0._r8
 
    logical :: DEF_USE_NOSTRESSNITROGEN  = .false. ! photosynthesis stress option
    integer :: DEF_RSTFAC                = 1       ! root resistance factors option
@@ -1186,6 +1190,7 @@ CONTAINS
       DEF_USE_IRRIGATION,                     & !add by Hongbin Liang @ sysu
       DEF_IRRIGATION_ALLOCATION,              & !add by Hongbin Liang @ sysu
       DEF_PADDY_RICE_BUND,                    & !C-32 (paper V2)
+      DEF_RICE_ROOT_EXUDATE,                  & !C-37 (paper V2)
       DEF_USE_NOSTRESSNITROGEN,               & !add by Hongbin Liang @ sysu
       DEF_RSTFAC,                             & !add by Hongbin Liang @ sysu
       DEF_LC_YEAR,                            &
@@ -1836,6 +1841,7 @@ CONTAINS
 
       CALL mpi_bcast (DEF_IRRIGATION_ALLOCATION              ,1   ,mpi_integer   ,p_address_master ,p_comm_glb ,p_err)
       CALL mpi_bcast (DEF_PADDY_RICE_BUND                    ,1   ,mpi_logical   ,p_address_master ,p_comm_glb ,p_err)
+      CALL mpi_bcast (DEF_RICE_ROOT_EXUDATE                  ,1   ,mpi_real8     ,p_address_master ,p_comm_glb ,p_err)
       CALL mpi_bcast (DEF_USE_NOSTRESSNITROGEN               ,1   ,mpi_logical   ,p_address_master ,p_comm_glb ,p_err)
       CALL mpi_bcast (DEF_RSTFAC                             ,1   ,mpi_integer   ,p_address_master ,p_comm_glb ,p_err)
 
