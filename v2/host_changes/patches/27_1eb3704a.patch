+            fpevp_year = year
+            fpevp_year_total = 0._r8
+         ENDIF
+         fpevp_year_total = fpevp_year_total + totalfpevp
+      ENDIF
+
       water_balance_err = totalvol_aft - totalvol_bef - totalrnof + totaldis
       water_balance_tol = max(1.e-6_r8, 1.e-10_r8 * max(abs(totalvol_bef), abs(totalvol_aft), &
          abs(totalrnof), abs(totaldis), 1._r8))
@@ -1767,6 +1805,76 @@ CONTAINS
    END SUBROUTINE sync_global_routing_dt
 
    ! ---------
+   SUBROUTINE accumulate_floodplain_evap (deltime)
+   ! C-44 (paper V2): Penman (1948) open-water evaporation in the form of
+   ! Shuttleworth (1993), E = [Delta Rn + gamma 6.43 (1 + 0.536 u2) D] /
+   ! [lambda (Delta + gamma)] in mm d-1 (Rn in MJ m-2 d-1, D in kPa), for a
+   ! water surface at air temperature (albedo 0.06, emissivity 0.97), u2 from
+   ! the forcing wind by the FAO-56 log profile, none below freezing. Night-time
+   ! negative values are kept, so a routing step takes the net demand. The
+   ! patch values go to unit catchments the way precipitation does for tracers.
+
+   USE MOD_LandPatch,      only: numpatch
+   USE MOD_Vars_1DForcing, only: forc_t, forc_q, forc_psrf, forc_us, forc_vs, forc_hgt_u, &
+      forc_sols, forc_soll, forc_solsd, forc_solld, forc_frl
+   USE MOD_Const_Physical, only: tfrz, stefnc
+   IMPLICIT NONE
+
+   real(r8), intent(in) :: deltime
+
+   real(r8), allocatable :: e_pch(:), e_gd(:), e_uc(:)
+   real(r8) :: tc, pkpa, es, ea, delta, gamma, rn, u2, z
+   integer  :: ip
+
+      IF (.not. allocated(acc_evp_uc)) THEN
+         allocate (acc_evp_uc (max(numucat,0)))
+         acc_evp_uc = 0._r8
+      ENDIF
+
+      allocate (e_pch (max(numpatch,0)))
+      allocate (e_gd  (max(numinpm, 0)))
+      allocate (e_uc  (max(numucat, 0)))
+
+      DO ip = 1, numpatch
+         e_pch(ip) = 0._r8
+         IF (.not. filter_rnof(ip)) CYCLE
+         tc = forc_t(ip) - tfrz
+         IF (tc <= 0._r8) CYCLE
+         pkpa  = forc_psrf(ip) * 1.e-3_r8
+         es    = 0.6108_r8 * exp(17.27_r8 * tc / (tc + 237.3_r8))
+         ea    = forc_q(ip) * pkpa / (0.622_r8 + 0.378_r8 * forc_q(ip))
+         delta = 4098._r8 * es / (tc + 237.3_r8)**2
+         gamma = 0.000665_r8 * pkpa
+         rn    = 0.94_r8 * (forc_sols(ip) + forc_soll(ip) + forc_solsd(ip) + forc_solld(ip)) &
+               + 0.97_r8 * (forc_frl(ip) - stefnc * forc_t(ip)**4)
+         z     = max(forc_hgt_u(ip), 2.1_r8)
+         u2    = sqrt(forc_us(ip)**2 + forc_vs(ip)**2) * 4.87_r8 / log(67.8_r8 * z - 5.42_r8)
+         e_pch(ip) = (delta * rn * 0.0864_r8 + gamma * 6.43_r8 * (1._r8 + 0.536_r8 * u2) &
+                   * max(es - ea, 0._r8)) / (2.45_r8 * (delta + gamma))          ! [mm d-1]
+      ENDDO
+
+      CALL worker_remap_data_pset2grid (remap_patch2inpm, e_pch, e_gd, &
+         fillvalue = 0., filter = filter_rnof)
+      IF (numinpm > 0) THEN
+         WHERE (push_ucat2inpm%sum_area > 0)
+            e_gd = e_gd / push_ucat2inpm%sum_area
+         END WHERE
+      ENDIF
+      CALL worker_push_data (push_inpm2ucat, e_gd, e_uc, fillvalue = 0., mode = 'sum')
+
+      IF (numucat > 0) THEN
+         WHERE (topo_area > 0._r8)
+            e_uc = e_uc / topo_area
+         ELSEWHERE
+            e_uc = 0._r8
+         END WHERE
+         acc_evp_uc = acc_evp_uc + e_uc * 1.e-3_r8 / 86400._r8 * deltime        ! [m]
+      ENDIF
+
+      deallocate (e_pch, e_gd, e_uc)
+
+   END SUBROUTINE accumulate_floodplain_evap
+
    SUBROUTINE grid_riverlake_flow_final ()
 
       CALL riverlake_network_final ()
