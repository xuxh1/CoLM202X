From 1eb3704a65c7d53e83e3e70523c656c593c2e534 Mon Sep 17 00:00:00 2001
From: xuxh1 <18172956238@163.com>
Date: Mon, 28 Sep 2026 09:29:17 +0800
Subject: [PATCH] feat(routing): open-water evaporation from the grid routing
 floodplain (C-44)

DEF_FLOODPLAIN_EVAP (default off): Penman open-water evaporation
(Shuttleworth 1993 form) from the forcing, accumulated per unit catchment
and taken off the flooded area beyond the channel at each routing step,
at most the water above bankfull; reservoirs and levee cells untouched.
The routing water balance counts it as negative input; the master logs the
yearly total.

---
 main/HYDRO/MOD_Grid_RiverLakeFlow.F90 | 114 +++++++++++++++++++++++++-
 share/MOD_Namelist.F90                |   5 ++
 2 files changed, 116 insertions(+), 3 deletions(-)

diff --git a/main/HYDRO/MOD_Grid_RiverLakeFlow.F90 b/main/HYDRO/MOD_Grid_RiverLakeFlow.F90
index 1f2f275c..fcdfcb8e 100644
--- a/main/HYDRO/MOD_Grid_RiverLakeFlow.F90
+++ b/main/HYDRO/MOD_Grid_RiverLakeFlow.F90
@@ -58,6 +58,13 @@ MODULE MOD_Grid_RiverLakeFlow
    ! MOD_Grid_RiverLakeTimeVars (imported via the module-wide USE above)
    ! so their mid-period state is serialised by WRITE/READ_GridRiverLakeTimeVars.
    logical,  allocatable :: filter_rnof (:)
+
+   ! C-44 (paper V2): open-water evaporation depth accumulated per unit
+   ! catchment between routing steps [m]; not in the restart file, so at most
+   ! one routing step (DEF_GRIDBASED_ROUTING_MAX_DT) of it is lost at a restart
+   real(r8), allocatable :: acc_evp_uc (:)
+   real(r8), save :: fpevp_year_total = 0._r8   ! [m3], master only
+   integer,  save :: fpevp_year = -1
 CONTAINS
 
    ! ---------
@@ -262,7 +269,8 @@ CONTAINS
    logical :: loop_active, next_loop_active
    real(r8) :: totalvol_bef, totalvol_aft, totalrnof, totaldis
    real(r8) :: water_balance_err, water_balance_tol
-   real(r8) :: water_balance_vec(4)
+   real(r8) :: water_balance_vec(5)
+   real(r8) :: fpevp, totalfpevp
 #ifdef CoLMDEBUG
    real(r8) :: totalclip
    real(r8), allocatable :: trc_mass_bef(:), trc_mass_aft(:)
@@ -296,6 +304,7 @@ CONTAINS
       totalvol_aft = 0._r8
       totalrnof = 0._r8
       totaldis = 0._r8
+      totalfpevp = 0._r8
       water_balance_err = 0._r8
       water_balance_tol = 0._r8
 
@@ -409,6 +418,8 @@ CONTAINS
          ENDIF
 #endif
 
+         IF (DEF_FLOODPLAIN_EVAP) CALL accumulate_floodplain_evap (deltime)
+
       ENDIF
 
 
@@ -601,6 +612,21 @@ CONTAINS
 
             volwater = volwater + acc_rnof_uc(i)
 
+            ! C-44: open-water evaporation from the flooded area beyond the
+            ! channel (the channel surface is part of the land water patches,
+            ! which evaporate on their own), at most the water above bankfull;
+            ! reservoirs and levee cells are left alone
+            IF (DEF_FLOODPLAIN_EVAP .and. allocated(acc_evp_uc)) THEN
+               IF ((.not. is_built_resv(i)) .and. (.not. (DEF_USE_LEVEE .and. has_levee(i)))) THEN
+                  fpevp = max(acc_evp_uc(i), 0._r8) * floodplain_curve(i)%floodarea (wdsrf_ucat(i))
+                  fpevp = min(fpevp, max(volwater - floodplain_curve(i)%rivstomax, 0._r8))
+                  volwater   = volwater - fpevp
+                  totalrnof  = totalrnof - fpevp
+                  totalfpevp = totalfpevp + fpevp
+               ENDIF
+               acc_evp_uc(i) = 0._r8
+            ENDIF
+
             IF (.not. is_built_resv(i)) THEN
                IF (DEF_USE_LEVEE .and. has_levee(i)) THEN
                   ! volwater already includes runoff, while the matching
@@ -1361,15 +1387,27 @@ CONTAINS
       ENDIF
 
 #ifdef USEMPI
-      water_balance_vec = (/ totalvol_bef, totalvol_aft, totalrnof, totaldis /)
+      water_balance_vec = (/ totalvol_bef, totalvol_aft, totalrnof, totaldis, totalfpevp /)
       IF (.not. p_is_worker) water_balance_vec = 0._r8
-      CALL mpi_allreduce (MPI_IN_PLACE, water_balance_vec, 4, MPI_REAL8, MPI_SUM, p_comm_glb, p_err)
+      CALL mpi_allreduce (MPI_IN_PLACE, water_balance_vec, 5, MPI_REAL8, MPI_SUM, p_comm_glb, p_err)
       totalvol_bef = water_balance_vec(1)
       totalvol_aft = water_balance_vec(2)
       totalrnof    = water_balance_vec(3)
       totaldis     = water_balance_vec(4)
+      totalfpevp   = water_balance_vec(5)
 #endif
 
+      ! C-44: one log line per year with the floodplain evaporation total
+      IF (DEF_FLOODPLAIN_EVAP .and. p_is_master) THEN
+         IF (fpevp_year /= year) THEN
+            IF (fpevp_year > 0) write(*,'(A,I5,A,ES12.4,A)') ' C-44 floodplain evaporation', &
