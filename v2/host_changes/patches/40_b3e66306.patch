             deallocate (rss                    )
@@ -1083,7 +1086,8 @@ CONTAINS
 
    USE MOD_SPMD_Task
    USE MOD_Namelist, only: DEF_REST_CompressLevel, DEF_USE_PLANTHYDRAULICS, DEF_USE_OZONESTRESS, &
-                           DEF_USE_IRRIGATION, DEF_USE_Dynamic_Lake, SITE_landtype
+                           DEF_USE_IRRIGATION, DEF_USE_Dynamic_Lake, SITE_landtype, &
