       CALL check_vector_data ('zwt         [m]    ', zwt        ) ! the depth to water table [m]
       CALL check_vector_data ('wa          [mm]   ', wa         ) ! water storage in aquifer [mm]
       CALL check_vector_data ('wetwat      [mm]   ', wetwat     ) ! water storage in wetland [mm]
