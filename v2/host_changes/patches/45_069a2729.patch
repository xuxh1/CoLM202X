+         IF (has_var) THEN
+            CALL ncio_read_bcast_serial (file_restart, 'fld_perm_year', fld_perm_year)
+            CALL vector_read_and_scatter (file_restart, fld_fmin_uc, numucat, 'fld_fmin_uc', ucat_data_address)
+            CALL vector_read_and_scatter (file_restart, fld_fmax_uc, numucat, 'fld_fmax_uc', ucat_data_address)
+            CALL vector_read_and_scatter (file_restart, fld_perm_uc, numucat, 'fld_perm_uc', ucat_data_address)
+         ENDIF
       ENDIF
 
       ! Validate finiteness before every ordered comparison so corrupted NaNs
@@ -763,10 +797,18 @@ CONTAINS
       CALL vector_gather_and_write (&
          volwater_ucat, numucat, totalnumucat, ucat_data_address, file_restart, 'volwater_ucat', 'ucatch')
 
-      ! Q-47: re-infiltration the storage still owes
+      ! Q-47: re-infiltration the storage still owes, and the flooded-all-year
+      ! flags with the extremes of the year under way
       IF (DEF_FLOODPLAIN_INFILTRATION .and. DEF_FLOODPLAIN_INFILT_FIX) THEN
          CALL vector_gather_and_write (&
             acc_inf_uc, numucat, totalnumucat, ucat_data_address, file_restart, 'acc_inf_uc', 'ucatch')
+         IF (p_is_master) CALL ncio_write_serial (file_restart, 'fld_perm_year', fld_perm_year)
+         CALL vector_gather_and_write (&
+            fld_fmin_uc, numucat, totalnumucat, ucat_data_address, file_restart, 'fld_fmin_uc', 'ucatch')
+         CALL vector_gather_and_write (&
+            fld_fmax_uc, numucat, totalnumucat, ucat_data_address, file_restart, 'fld_fmax_uc', 'ucatch')
+         CALL vector_gather_and_write (&
+            fld_perm_uc, numucat, totalnumucat, ucat_data_address, file_restart, 'fld_perm_uc', 'ucatch')
       ENDIF
 
       IF (DEF_USE_LEVEE) THEN
@@ -796,6 +838,10 @@ CONTAINS
       IF (allocated (volwater_ucat)) deallocate (volwater_ucat)
       IF (allocated (acc_rnof_uc)) deallocate (acc_rnof_uc)
       IF (allocated (acc_inf_uc )) deallocate (acc_inf_uc )
+      IF (allocated (fld_fmin_uc)) deallocate (fld_fmin_uc)
+      IF (allocated (fld_fmax_uc)) deallocate (fld_fmax_uc)
+      IF (allocated (fld_perm_uc)) deallocate (fld_perm_uc)
+      fld_perm_year = -1
       acctime_rnof = 0._r8
       wdsrf_ucat_prev_valid = .false.
       wdsrf_ucat_prev_restart_found = .false.
