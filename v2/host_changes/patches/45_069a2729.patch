    ! -- restart file path (saved for deferred particle-tracer restart read) --
    character(len=512) :: gridriver_restart_file = ''
@@ -444,6 +453,13 @@ CONTAINS
       acc_rnof_uc = 0._r8
       allocate (acc_inf_uc (ncell_state))
       acc_inf_uc = 0._r8
+      allocate (fld_fmin_uc (ncell_state))
+      allocate (fld_fmax_uc (ncell_state))
+      allocate (fld_perm_uc (ncell_state))
+      fld_fmin_uc = 1._r8
+      fld_fmax_uc = 0._r8
+      fld_perm_uc = 0._r8
+      fld_perm_year = -1
       wdsrf_ucat_prev = 0._r8
 
       ! Allocated on every rank because read_levee_restart is collective and
@@ -492,6 +508,10 @@ CONTAINS
       acctime_rnof = 0._r8
       IF (allocated(acc_rnof_uc)) acc_rnof_uc = 0._r8
       IF (allocated(acc_inf_uc)) acc_inf_uc = 0._r8
+      IF (allocated(fld_fmin_uc)) fld_fmin_uc = 1._r8
+      IF (allocated(fld_fmax_uc)) fld_fmax_uc = 0._r8
+      IF (allocated(fld_perm_uc)) fld_perm_uc = 0._r8
+      fld_perm_year = -1
       IF (allocated(wdsrf_ucat_prev)) wdsrf_ucat_prev = 0._r8
       wdsrf_ucat_prev_valid = .false.
       wdsrf_ucat_prev_restart_found = .false.
@@ -624,6 +644,20 @@ CONTAINS
 #endif
             IF (invalid_base_count > 0) CALL CoLM_stop ('invalid acc_inf_uc in GridRiverLake restart')
          ENDIF
+
+         ! the flooded-all-year flags and the extremes of the year under way;
+         ! a restart without them flags none until a year has been seen
+         has_var = .false.
+         IF (p_is_master) has_var = ncio_var_exist(file_restart, 'fld_perm_year', readflag = .false.)
+#ifdef USEMPI
+         CALL mpi_bcast (has_var, 1, MPI_LOGICAL, p_address_master, p_comm_glb, p_err)
