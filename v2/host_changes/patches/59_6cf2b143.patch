+         ENDIF
+      ENDIF
+
       ! Validate finiteness before every ordered comparison so corrupted NaNs
       ! are rejected cleanly under -ffpe-trap=invalid. acc_rnof_uc may be
       ! signed by upstream forcing/numerics, so only its finiteness is an
@@ -733,7 +764,7 @@ CONTAINS
 
    USE MOD_SPMD_Task
    USE MOD_Namelist,              only: DEF_Reservoir_Method, DEF_USE_LEVEE, DEF_USE_BIFURCATION, &
-      DEF_FLOODPLAIN_INFILTRATION, DEF_FLOODPLAIN_INFILT_FIX
+      DEF_FLOODPLAIN_INFILTRATION, DEF_FLOODPLAIN_INFILT_FIX, DEF_LAKE_EVAP_ROUTING
    USE MOD_NetCDFSerial
    USE MOD_Vector_ReadWrite
    USE MOD_Grid_RiverLakeNetwork, only: numucat, totalnumucat, ucat_data_address, &
@@ -811,6 +842,12 @@ CONTAINS
             fld_perm_uc, numucat, totalnumucat, ucat_data_address, file_restart, 'fld_perm_uc', 'ucatch')
       ENDIF
 
+      ! I-29: lake evaporation the storage still owes
+      IF (DEF_LAKE_EVAP_ROUTING) THEN
+         CALL vector_gather_and_write (&
+            acc_ldef_uc, numucat, totalnumucat, ucat_data_address, file_restart, 'acc_ldef_uc', 'ucatch')
+      ENDIF
+
       IF (DEF_USE_LEVEE) THEN
          CALL vector_gather_and_write (&
             levsto, numucat, totalnumucat, ucat_data_address, file_restart, 'levsto', 'ucatch')
@@ -841,6 +878,7 @@ CONTAINS
       IF (allocated (fld_fmin_uc)) deallocate (fld_fmin_uc)
       IF (allocated (fld_fmax_uc)) deallocate (fld_fmax_uc)
       IF (allocated (fld_perm_uc)) deallocate (fld_perm_uc)
+      IF (allocated (acc_ldef_uc)) deallocate (acc_ldef_uc)
       fld_perm_year = -1
       acctime_rnof = 0._r8
       wdsrf_ucat_prev_valid = .false.
