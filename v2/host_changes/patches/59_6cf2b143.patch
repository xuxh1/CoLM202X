+   ! catchment, mapped the way runoff is [m2]; the lake evaporation deficit
+   ! of the lake patches and the part of it that reached a unit catchment
+   ! since the last routing step [m3], per worker; and the yearly totals of
+   ! these two and of what the storage gave, with what it still owed after
+   ! the last routing step [m3], master only
+   real(r8), allocatable :: lake_area_uc (:)
+   real(r8), save :: ldef_land_acc  = 0._r8
+   real(r8), save :: ldef_route_acc = 0._r8
+   real(r8), save :: ldef_year_land  = 0._r8
+   real(r8), save :: ldef_year_route = 0._r8
+   real(r8), save :: ldef_year_take  = 0._r8
+   real(r8), save :: ldef_carry_last = 0._r8
+   integer,  save :: ldef_year = -1
 CONTAINS
 
    ! ---------
@@ -291,6 +305,7 @@ CONTAINS
    real(r8) :: water_balance_err, water_balance_tol
    real(r8) :: water_balance_vec(6)
    real(r8) :: fpevp, totalfpevp, fpinf, totalfpinf, fpinf_carry, fpfrc
+   real(r8) :: ldtake, totalldtake, ldef_vec(4)
 #ifdef CoLMDEBUG
    real(r8) :: totalclip
    real(r8), allocatable :: trc_mass_bef(:), trc_mass_aft(:)
@@ -326,6 +341,7 @@ CONTAINS
       totaldis = 0._r8
       totalfpevp = 0._r8
       totalfpinf = 0._r8
+      totalldtake = 0._r8
       water_balance_err = 0._r8
       water_balance_tol = 0._r8
 
@@ -441,6 +457,7 @@ CONTAINS
 
          IF (DEF_FLOODPLAIN_EVAP) CALL accumulate_floodplain_evap (deltime)
          IF (DEF_FLOODPLAIN_INFILTRATION) CALL accumulate_flood_infiltration (deltime)
+         IF (DEF_LAKE_EVAP_ROUTING) CALL accumulate_lake_deficit (deltime)
 
       ENDIF
 
@@ -634,13 +651,31 @@ CONTAINS
 
             volwater = volwater + acc_rnof_uc(i)
 
+            ! I-29: the lake patches' evaporation beyond their precipitation
+            ! comes out of the storage they drain to, as far as it goes; what
+            ! it cannot give now it gives later
+            IF (DEF_LAKE_EVAP_ROUTING) THEN
+               ldtake = min(max(acc_ldef_uc(i), 0._r8), max(volwater, 0._r8))
+               volwater    = volwater - ldtake
+               totalrnof   = totalrnof - ldtake
+               totalldtake = totalldtake + ldtake
+               acc_ldef_uc(i) = acc_ldef_uc(i) - ldtake
+            ENDIF
+
             ! C-44: open-water evaporation from the flooded area beyond the
             ! channel (the channel surface is part of the land water patches,
             ! which evaporate on their own), at most the water above bankfull;
             ! reservoirs and levee cells are left alone
             IF (DEF_FLOODPLAIN_EVAP .and. allocated(acc_evp_uc)) THEN
                IF ((.not. is_built_resv(i)) .and. (.not. (DEF_USE_LEVEE .and. has_levee(i)))) THEN
-                  fpevp = max(acc_evp_uc(i), 0._r8) * floodplain_curve(i)%floodarea (wdsrf_ucat(i))
+                  IF (DEF_LAKE_EVAP_ROUTING .and. allocated(lake_area_uc)) THEN
+                     ! I-29: the flood lies on the lake patches first, whose
+                     ! evaporation the storage now pays above
+                     fpevp = max(acc_evp_uc(i), 0._r8) &
+                        * max(floodplain_curve(i)%floodarea (wdsrf_ucat(i)) - lake_area_uc(i), 0._r8)
+                  ELSE
+                     fpevp = max(acc_evp_uc(i), 0._r8) * floodplain_curve(i)%floodarea (wdsrf_ucat(i))
+                  ENDIF
                   fpevp = min(fpevp, max(volwater - floodplain_curve(i)%rivstomax, 0._r8))
                   volwater   = volwater - fpevp
                   totalrnof  = totalrnof - fpevp
@@ -1443,6 +1478,42 @@ CONTAINS
 #endif
       ENDIF
 
+      ! I-29: lake evaporation deficit of the lake patches, the part that
+      ! reached a unit catchment, what the storage gave and what it still
+      ! owes; one log line per year
+      IF (DEF_LAKE_EVAP_ROUTING) THEN
+         ldef_vec = 0._r8
+         IF (p_is_worker) THEN
+            ldef_vec(1) = ldef_land_acc
+            ldef_vec(2) = ldef_route_acc
+            ldef_vec(3) = totalldtake
+            IF (numucat > 0) ldef_vec(4) = sum(acc_ldef_uc)
+         ENDIF
+#ifdef USEMPI
+         CALL mpi_allreduce (MPI_IN_PLACE, ldef_vec, 4, MPI_REAL8, MPI_SUM, p_comm_glb, p_err)
+#endif
+         ldef_land_acc  = 0._r8
+         ldef_route_acc = 0._r8
+         IF (p_is_master) THEN
+            IF (ldef_year /= year) THEN
+               IF (ldef_year > 0) THEN
+                  write(*,'(A,I5,A,ES12.4,A,ES12.4,A,ES12.4,A,ES12.4,A)') ' I-29 lake evaporation deficit', &
+                     ldef_year, ': lake patches', ldef_year_land*1.e-9_r8, ' km3; to unit catchments', &
+                     ldef_year_route*1.e-9_r8, ' km3; taken from storage', ldef_year_take*1.e-9_r8, &
+                     ' km3; owed at year end', ldef_carry_last*1.e-9_r8, ' km3'
+               ENDIF
+               ldef_year = year
+               ldef_year_land  = 0._r8
+               ldef_year_route = 0._r8
+               ldef_year_take  = 0._r8
+            ENDIF
+            ldef_year_land  = ldef_year_land  + ldef_vec(1)
+            ldef_year_route = ldef_year_route + ldef_vec(2)
+            ldef_year_take  = ldef_year_take  + ldef_vec(3)
+            ldef_carry_last = ldef_vec(4)
+         ENDIF
+      ENDIF
+
       ! C-44: one log line per year with the floodplain evaporation total
       IF ((DEF_FLOODPLAIN_EVAP .or. DEF_FLOODPLAIN_INFILTRATION) .and. p_is_master) THEN
          IF (fpevp_year /= year) THEN
@@ -2205,6 +2276,71 @@ CONTAINS
 
    END SUBROUTINE accumulate_floodplain_evap
 
+   SUBROUTINE accumulate_lake_deficit (deltime)
+   ! I-29 (paper V2): the lake patches (patchtype 4) give no runoff when their
+   ! evaporation exceeds their precipitation, and the land side books the
+   ! difference (lake_deficit, mm/s) as water put back into the patch. Gather
+   ! it per unit catchment the way runoff is [m3], for the routing step to
+   ! take out of the storage. On the first call also map the lake patch area
+   ! to the unit catchments [m2], by which C-44 leaves the lakes out.
+   USE MOD_LandPatch,           only: numpatch
+   USE MOD_Vars_TimeInvariants, only: patchtype
+   USE MOD_Vars_1DFluxes,       only: lake_deficit
+   USE MOD_Vars_Global,         only: spval
+   IMPLICIT NONE
+
+   real(r8), intent(in) :: deltime
+
+   real(r8), allocatable :: d_pch(:), d_gd(:), d_uc(:)
+   integer :: ip
+
+      allocate (d_pch (max(numpatch,0)))
+      allocate (d_gd  (max(numinpm, 0)))
+      allocate (d_uc  (max(numucat, 0)))
+
+      IF (.not. allocated(lake_area_uc)) THEN
+         allocate (lake_area_uc (max(numucat,0)))
+         DO ip = 1, numpatch
+            d_pch(ip) = 0._r8
+            IF (patchtype(ip) == 4) d_pch(ip) = 1._r8
+         ENDDO
+         CALL worker_remap_data_pset2grid (remap_patch2inpm, d_pch, d_gd, &
+            fillvalue = 0._r8, filter = filter_rnof)
+         IF (numinpm > 0) THEN
+            WHERE (push_ucat2inpm%sum_area > 0)
+               d_gd = d_gd / push_ucat2inpm%sum_area
+            END WHERE
+         ENDIF
+         CALL worker_push_data (push_inpm2ucat, d_gd, d_uc, fillvalue = 0._r8, mode = 'sum')
+         IF (numucat > 0) lake_area_uc = d_uc
+      ENDIF
+
+      DO ip = 1, numpatch
+         d_pch(ip) = 0._r8
+         IF (patchtype(ip) == 4 .and. filter_rnof(ip)) THEN
+            IF (lake_deficit(ip) /= spval) d_pch(ip) = max(lake_deficit(ip), 0._r8)
+         ENDIF
+      ENDDO
+
+      CALL worker_remap_data_pset2grid (remap_patch2inpm, d_pch, d_gd, &
+         fillvalue = 0._r8, filter = filter_rnof)
+      IF (numinpm > 0) THEN
+         ldef_land_acc = ldef_land_acc + sum(d_gd) * 1.e-3_r8 * deltime
+         WHERE (push_ucat2inpm%sum_area > 0)
+            d_gd = d_gd / push_ucat2inpm%sum_area
+         END WHERE
+      ENDIF
+      CALL worker_push_data (push_inpm2ucat, d_gd, d_uc, fillvalue = 0._r8, mode = 'sum')
+
+      IF (numucat > 0) THEN
+         acc_ldef_uc    = acc_ldef_uc + d_uc * 1.e-3_r8 * deltime
+         ldef_route_acc = ldef_route_acc + sum(d_uc) * 1.e-3_r8 * deltime
+      ENDIF
+
+      deallocate (d_pch, d_gd, d_uc)
+
+   END SUBROUTINE accumulate_lake_deficit
+
    SUBROUTINE grid_riverlake_flow_final ()
 
       CALL riverlake_network_final ()
@@ -2226,6 +2362,7 @@ CONTAINS
       ! acc_rnof_uc is owned by MOD_Grid_RiverLakeTimeVars and freed by
       ! deallocate_GridRiverLakeTimeVars; don't deallocate it here.
       IF (allocated(filter_rnof)) deallocate(filter_rnof)
