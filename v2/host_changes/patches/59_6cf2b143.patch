+         has_var = .false.
+         IF (p_is_master) has_var = ncio_var_exist(file_restart, 'acc_ldef_uc', readflag = .false.)
+#ifdef USEMPI
+         CALL mpi_bcast (has_var, 1, MPI_LOGICAL, p_address_master, p_comm_glb, p_err)
