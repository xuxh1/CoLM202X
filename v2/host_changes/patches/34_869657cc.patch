--- /dev/null
+++ b/main/MOD_FloodInfiltration.F90
@@ -0,0 +1,31 @@
+#include <define.h>
+
+MODULE MOD_FloodInfiltration
+!-----------------------------------------------------------------------
+! Q-43 (paper V2): re-infiltration of floodplain water into the soil of
+! flooded soil patches when the grid-based river routing (or, in a single
+! point, a site flood series) floods them. The soil side follows the
+! CaMa-Flood re-infiltration (LWINFILT) block of WATER_VSF; the routing
+! takes the infiltrated water out of its storage at the next routing step.
+!-----------------------------------------------------------------------
+   USE MOD_Precision
+   IMPLICIT NONE
+   SAVE
+
+   real(r8), allocatable :: fld_frc_p    (:)  ! flooded fraction of the patch [-]
+   real(r8), allocatable :: fld_dph_p    (:)  ! flood water depth over the flooded part [mm]
+   real(r8), allocatable :: fld_qinfl_p  (:)  ! patch-mean re-infiltration of this step [mm/s]
+
+CONTAINS
+
+   SUBROUTINE flood_infil_alloc (npatch)
+      integer, intent(in) :: npatch
+      IF (.not. allocated(fld_frc_p)) THEN
+         allocate (fld_frc_p(max(npatch,0)), fld_dph_p(max(npatch,0)), fld_qinfl_p(max(npatch,0)))
+         fld_frc_p   = 0._r8
+         fld_dph_p   = 0._r8
+         fld_qinfl_p = 0._r8
+      ENDIF
+   END SUBROUTINE flood_infil_alloc
+
+END MODULE MOD_FloodInfiltration
